<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 1000">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f5f5f0" />
      <stop offset="100%" stop-color="#e8e5de" />
    </linearGradient>
  </defs>
  <rect width="800" height="1000" fill="url(#bg)" />
  
    <rect x="150" y="200" width="500" height="600" rx="20" fill="#4a3e2c" opacity="0.15"/>
    <rect x="200" y="250" width="400" height="500" rx="12" fill="#4a3e2c" opacity="0.08"/>
    <text x="400" y="540" text-anchor="middle" fill="#4a3e2c" font-family="system-ui" font-size="32" font-weight="bold" opacity="0.4">Coat Detail</text>
    <text x="400" y="580" text-anchor="middle" fill="#4a3e2c" font-family="system-ui" font-size="16" opacity="0.25">Demo Product Image</text>
</svg>